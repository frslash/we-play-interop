# We Play Interop: every setting comes from the environment. Copy to .env for local runs.
# Secrets (WORKSPACE_KEY, LLM_API_KEY, GITHUB_TOKEN, DATABASE_URL) go only in your host's
# secret store, never in the repository.

# --- the workspace
# The workspace's own key (64 hex). It signs the weaver's posts and witnesses every log entry.
# Make one with: npm run keygen. Required when NODE_ENV=production; keep it forever (the log
# is tied to it). Without it, a development key is made in DATA_DIR.
WORKSPACE_KEY=
WORKSPACE_NAME=We Play Interop
# The address people reach it at (used in links and pull request text), e.g. https://interop.example
PUBLIC_URL=
PORT=3000
NODE_ENV=development

# --- storage
# A Postgres connection string. Use one whose storage is encrypted at rest (managed Postgres
# providers do this by default). Leave empty to run the same Postgres embedded (PGlite) in DATA_DIR.
DATABASE_URL=
DATA_DIR=./data

# --- the DTG board: the first source of the map (any other source can join it)
BOARD_REPO=Project-Weave-Tech/dtg-interop
BOARD_DATA_URL=https://project-weave-tech.github.io/dtg-interop/data.json
BOARD_REFRESH_MINUTES=15

# --- the weaver's model, option 1: Claude, through Anthropic's official SDK
# Used whenever ANTHROPIC_API_KEY is set. Model: Claude Opus 5.5 unless ANTHROPIC_MODEL says otherwise.
# A declined round is retried on another Claude model in the same call (server-side fallback).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max: how much the model thinks per round
LLM_EFFORT=medium
# Force a choice (anthropic | openai) instead of deciding by which key is set:
LLM_PROVIDER=

# --- the weaver's model, option 2: any OpenAI-compatible endpoint (used when no ANTHROPIC_API_KEY is set)
# Default: the Inference Cooperative gateway. Its enclave (TEE) models have ids starting
# with tinfoil/; with LLM_MODEL empty the weaver picks one of those first.
LLM_BASE_URL=https://gateway.inference.coop/v1
LLM_API_KEY=
LLM_MODEL=
LLM_PREFER_PREFIX=tinfoil/
LLM_TIMEOUT_SECONDS=120
# Without LLM_API_KEY the weaver still runs, as a plain tally, and every round says so.

# --- the loop
# the weaver speaks after a pause in the conversation, at most this often
WEAVER_INTERVAL_MINUTES=10
WEAVER_QUIET_MINUTES=2
# smart (the right Claude model per round) or a model id
WEAVER_MODEL=smart
# answers agents may give while their people are away, across the whole room, per hour
AWAY_ANSWERS_PER_HOUR=120
# entries a person (with their agents) may add per minute
RATE_PER_MINUTE=30
VETO_WINDOW_MINUTES=10
APPROVALS_REQUIRED=1
MAX_SKEW_MINUTES=10

# --- acting outside the workspace
# A GitHub token for a bot account. It needs: public_repo (fork dtg-interop, open pull requests
# and issues there) and, on WORKSPACE_REPO, contents + pull requests + commit statuses write.
# Without it, approved actions are prepared as links a person opens, and the log says so.
GITHUB_TOKEN=
WORKSPACE_REPO=Project-Weave-Tech/we-play-interop
