# Default-deny. Only exact paths and methods below are forwarded; everything else is 404, /admin included.
# Refusals are logged by reason only: no body, no query string, no headers.
resolver [fd12::10] valid=10s ipv6=on;   # Railway's private-network DNS

limit_req_zone  $binary_remote_addr zone=perip:10m rate=10r/s;
limit_conn_zone $binary_remote_addr zone=connperip:10m;

log_format refusal '$time_iso8601 refused host=$host method=$request_method reason=$refusal_reason';
map $host $refusal_reason { default "path-or-method-not-allowed"; }

server {
  listen 8080 default_server;
  server_name _;
  return 404;
}

# ---- vtc.inwove.org ----
server {
  listen 8080;
  server_name vtc.inwove.org;
  include /etc/nginx/conf.d/common.inc;
  set $upstream ${VTC_UPSTREAM};

  location = /.well-known/did.jsonl         { limit_except GET { deny all; } proxy_pass http://$upstream; }
  location = /.well-known/did-witness.json  { limit_except GET { deny all; } proxy_pass http://$upstream; }
  location = /health                        { limit_except GET { deny all; } proxy_pass http://$upstream; }
  # The join page says, on top of whatever the VTC serves, that this is a test community on test keys.
  location = /members/                      {
    limit_except GET { deny all; }
    # sub_filter needs an unzipped body. Setting one proxy_set_header here drops the inherited ones, so all three are repeated.
    proxy_set_header Accept-Encoding "";
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $remote_addr;
    sub_filter_once on;
    sub_filter '</head>' '<style>body::before{content:"TEST community on test keys. It may be wiped. Do not rely on anything here.";display:block;padding:.6em 1em;background:#fde68a;color:#111;font:600 1rem/1.4 sans-serif;text-align:center}</style></head>';
    proxy_pass http://$upstream;
  }
  location ^~ /members/static/              { limit_except GET { deny all; } proxy_pass http://$upstream; }
  location = /v1/join-requests              { limit_except POST { deny all; } proxy_pass http://$upstream; }
  location / { access_log /dev/stdout refusal; return 404; }
}

# ---- vta.inwove.org: its DID files only ----
server {
  listen 8080;
  server_name vta.inwove.org;
  include /etc/nginx/conf.d/common.inc;
  set $upstream ${VTA_UPSTREAM};

  location = /.well-known/did.jsonl         { limit_except GET { deny all; } proxy_pass http://$upstream; }
  location = /.well-known/did-witness.json  { limit_except GET { deny all; } proxy_pass http://$upstream; }
  location / { access_log /dev/stdout refusal; return 404; }
}

# ---- mediator.inwove.org: its DID and the TSP/DIDComm endpoint ----
server {
  listen 8080;
  server_name mediator.inwove.org;
  include /etc/nginx/conf.d/common.inc;
  set $upstream ${MEDIATOR_UPSTREAM};

  location = /.well-known/did.jsonl         { limit_except GET { deny all; } proxy_pass http://$upstream; }
  location = /mediator/v1/ws                { proxy_http_version 1.1; proxy_set_header Upgrade $http_upgrade; proxy_set_header Connection "upgrade"; proxy_read_timeout 300s; proxy_pass http://$upstream; }
  location = /mediator/v1/inbound           { limit_except POST { deny all; } proxy_pass http://$upstream; }
  location / { access_log /dev/stdout refusal; return 404; }
}
