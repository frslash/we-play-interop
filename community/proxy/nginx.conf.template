# Default-deny. Only the paths and methods below are forwarded; everything else is a 404, the console included.
# Refusals are logged by reason only: no body, no query string, no headers.
# Each path was read from the code these services are built from (the projects shelf names the commits):
#   community: vtc-service/src/server.rs and routes/ (the document door is POST /v1/trust-tasks: every join, pass
#              and room call is a signed document sent there; there is no /v1/join-requests route);
#   agent:     vta-service/src/routes/self_hosted_did.rs (its DID log; its own door stays on the private network);
#   mediator:  crates/affinidi-messaging-mediator/src/handlers/mod.rs (the calls under /mediator/v1/ a member uses,
#              not /whoami, /oob, /readyz, /metrics), plus its DID log.
resolver [fd12::10] valid=10s ipv6=on;   # Railway's private-network DNS

limit_req_zone  $binary_remote_addr zone=perip:10m rate=10r/s;
limit_conn_zone $binary_remote_addr zone=connperip:10m;
# /inbound and /ws upgrades: a tighter per-address limit than the general one (Security 11114 cond 3).
# Stands for: bad or unsigned posts must be stopped here, before they cost the mediator anything.
# 2 requests/second with a burst of 5 is far above one honest member; it is a tripwire, not the need.
limit_req_zone  $binary_remote_addr zone=mediator_in:10m rate=2r/s;
limit_conn_zone $binary_remote_addr zone=mediator_ws:10m;

log_format refusal '$time_iso8601 refused host=$host method=$request_method reason=$refusal_reason';
map $host $refusal_reason { default "path-or-method-not-allowed"; }

server {
  listen 8080 default_server;
  server_name _;
  return 404;
}

# ---- vtc.inwove.org: the community ----
server {
  listen 8080;
  server_name vtc.inwove.org;
  include /etc/nginx/conf.d/common.inc;
  set $upstream ${VTC_UPSTREAM};

  # its DID, and the DIDs of the rooms and groups it hosts
  location = /.well-known/did.jsonl         { limit_except GET { deny all; } proxy_pass http://$upstream; }
  location ^~ /room-dids/                   { limit_except GET { deny all; } proxy_pass http://$upstream; }
  location ^~ /group-dids/                  { limit_except GET { deny all; } proxy_pass http://$upstream; }
  location = /health                        { limit_except GET { deny all; } proxy_pass http://$upstream; }
  # the door: every signed document (join, pass, room, sign-in) comes in here
  location = /v1/trust-tasks                { limit_except POST { deny all; } proxy_pass http://$upstream; }
  # what anyone may read: who the community is, its DID as a QR, and which passes it has withdrawn
  location = /v1/community/public-profile   { limit_except GET { deny all; } proxy_pass http://$upstream; }
  location = /v1/community/did-qr.svg       { limit_except GET { deny all; } proxy_pass http://$upstream; }
  location ^~ /v1/status-lists/             { limit_except GET { deny all; } proxy_pass http://$upstream; }
  # the join page (files to read) and the member sign-in calls. No /members: this build has no admin-ui, which is
  # what mounts the portal there (vtc-service/src/routes/mod.rs:1471-1477).
  location = /                              { limit_except GET { deny all; } proxy_pass http://$upstream; }
  location = /tokens.css                    { limit_except GET { deny all; } proxy_pass http://$upstream; }
  location = /site.css                      { limit_except GET { deny all; } proxy_pass http://$upstream; }
  location = /fonts.css                     { limit_except GET { deny all; } proxy_pass http://$upstream; }
  location = /site.js                       { limit_except GET { deny all; } proxy_pass http://$upstream; }
  location = /theme.js                      { limit_except GET { deny all; } proxy_pass http://$upstream; }
  location ^~ /fonts/                       { limit_except GET { deny all; } proxy_pass http://$upstream; }
  location ^~ /v1/member/                   { limit_except GET POST { deny all; } proxy_pass http://$upstream; }
  location / { access_log /dev/stdout refusal; return 404; }
}

# ---- vta.inwove.org: the trust agent's DID log only ----
server {
  listen 8080;
  server_name vta.inwove.org;
  include /etc/nginx/conf.d/common.inc;
  set $upstream ${VTA_UPSTREAM};

  location = /.well-known/did.jsonl         { limit_except GET { deny all; } proxy_pass http://$upstream; }
  location / { access_log /dev/stdout refusal; return 404; }
}

# ---- mediator.inwove.org: its DID and its messaging endpoints ----
server {
  listen 8080;
  server_name mediator.inwove.org;
  include /etc/nginx/conf.d/common.inc;
  # Bodies: the 64 KB cap of common.inc, except /inbound (96k, below). Every other call here is a small signed request.
  set $upstream ${MEDIATOR_UPSTREAM};

  location = /.well-known/did.jsonl             { limit_except GET { deny all; } proxy_pass http://$upstream; }
  location = /.well-known/did.json              { limit_except GET { deny all; } proxy_pass http://$upstream; }
  # /ws and /inbound: GET-only websocket, and the tighter per-address limits (Security 11114 cond 3).
  location = /mediator/v1/ws                    { limit_except GET { deny all; } limit_req zone=mediator_in burst=5 nodelay; limit_conn mediator_ws 5; proxy_http_version 1.1; proxy_set_header Upgrade $http_upgrade; proxy_set_header Connection "upgrade"; proxy_read_timeout 300s; proxy_pass http://$upstream; }
  # client_max_body_size here stands for: a little above the largest packed message the room honestly sends
  # (its records are capped at 64 KiB before packing; packing adds roughly a third). Security's condition 11114.
  # The mediator has its own caps behind this (message_size 1 MiB, checked after sign-in: src/messages/inbound.rs),
  # so this one is the tighter, earlier one. Revisit when the real largest message is known.
  location = /mediator/v1/inbound               { limit_except POST { deny all; } client_max_body_size 96k; limit_req zone=mediator_in burst=5 nodelay; proxy_pass http://$upstream; }
  # signing in, and a member's own mailbox (each needs a signed session from the mediator itself; src/handlers/mod.rs)
  location = /mediator/v1/authenticate/challenge { limit_except POST { deny all; } proxy_pass http://$upstream; }
  location = /mediator/v1/authenticate          { limit_except POST { deny all; } proxy_pass http://$upstream; }
  location = /mediator/v1/authenticate/refresh  { limit_except POST { deny all; } proxy_pass http://$upstream; }
  location = /mediator/v1/tsp/authenticate      { limit_except POST { deny all; } proxy_pass http://$upstream; }
  location = /mediator/v1/outbound              { limit_except POST { deny all; } proxy_pass http://$upstream; }
  location = /mediator/v1/fetch                 { limit_except POST { deny all; } proxy_pass http://$upstream; }
  location = /mediator/v1/delete                { limit_except DELETE { deny all; } proxy_pass http://$upstream; }
  location ^~ /mediator/v1/list/                { limit_except GET { deny all; } proxy_pass http://$upstream; }
  location = /mediator/v1/livez                 { limit_except GET { deny all; } proxy_pass http://$upstream; }
  location / { access_log /dev/stdout refusal; return 404; }
}
